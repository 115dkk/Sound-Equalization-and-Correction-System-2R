{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SECS 2R",
  "mainBinaryName": "secs2r",
  "identifier": "io.github.115dkk.secs2r",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "title": "SECS 2R",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SECS 2R contributors",
    "category": "Utility",
    "shortDescription": "Room correction design from speaker measurements",
    "longDescription": "SECS 2R designs room correction (RC), bass alignment (BA) and MIMO bass decay correction from speaker measurements and exports CamillaDSP configurations and REW mdat files. A Rust and Tauri rewrite of SECS 2.",
    "copyright": "GPL-3.0-only",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "macos/Entitlements.plist",
      "infoPlist": "macos/Info.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "macos/ko.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "sound"
      }
    }
  }
}
