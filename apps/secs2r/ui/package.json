{
  "name": "secs2r-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build --mode app",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "tauri": "tauri",
    "build:gallery": "tsc -b && vite build",
    "gallery:shots": "node scripts/gallery-shots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.14.5",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
