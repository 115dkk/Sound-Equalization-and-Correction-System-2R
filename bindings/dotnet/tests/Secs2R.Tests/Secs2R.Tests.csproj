<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <NativeManifest>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../native/Cargo.toml'))</NativeManifest>
    <Secs2RVersion>$([System.Text.RegularExpressions.Regex]::Match('$(NativeManifest)', '(?m)^version = &quot;([^&quot;\r\n]+)&quot;').Groups[1].Value)</Secs2RVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Secs2R" Version="$(Secs2RVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Secs2RCrateVersion" Value="$(Secs2RVersion)" />
  </ItemGroup>
</Project>
