<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="../artifacts/nuget-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="local-secs2r" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Once Secs2R is on nuget.org, its released version shares the number of
       the package just packed until the release gate bumps it; the tests must
       restore the packed one. -->
  <packageSourceMapping>
    <packageSource key="local-secs2r">
      <package pattern="Secs2R" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
