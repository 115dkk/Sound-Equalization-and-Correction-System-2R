# SECS 2 calibration - Equalizer APO config (generated)
# Copy everything in this folder into the Equalizer APO config folder
# (C:\Program Files\EqualizerAPO\config) - keep the old config.txt somewhere first.
# Device format: 48000 Hz (the FIR wav files are 48 kHz). Speaker setup: enough channels for the numbers below.
#
# Default channel numbers (1 = first channel of the device, Windows order FL FR FC LFE BL BR SL SR ...):
#   L      input  1   output  1
#   R      input  2   output  2
#   C      input  3   output  3
#   Ls     input  7   output  7
#   Rs     input  8   output  8
#   Lb     input  5   output  5
#   Rb     input  6   output  6
#   Tfl    input  9   output  9
#   Tfr    input 10   output 10
#   Tbl    input 11   output 11
#   Tbr    input 12   output 12
#   LFE    input  4
#   SW1               output  4
#   SW2               output 13
#   SW3               output 14
# Latency of the filters: 198.0 ms (video: delay the picture or set the player audio offset).

# ==== EDIT ONLY THESE TWO LINES: device channel number of each SECS input / output (0 = not used) ====
Eval: inL = 1; inR = 2; inC = 3; inLs = 7; inRs = 8; inLb = 5; inRb = 6; inTfl = 9; inTfr = 10; inTbl = 11; inTbr = 12; inLFE = 4
Eval: outL = 1; outR = 2; outC = 3; outLs = 7; outRs = 8; outLb = 5; outRb = 6; outTfl = 9; outTfr = 10; outTbl = 11; outTbr = 12; outSW1 = 4; outSW2 = 13; outSW3 = 14
# ==== do not edit below ====

# Headroom for the largest boost of the correction (avoids clipping).
Channel: all
Preamp: -10.0 dB

# Inputs: start silent, then copy each device channel that exists (a missing channel stays silent).
Copy: VML=0.0 VMR=0.0 VMC=0.0 VMLS=0.0 VMRS=0.0 VMLB=0.0 VMRB=0.0 VMTFL=0.0 VMTFR=0.0 VMTBL=0.0 VMTBR=0.0 VLFE=0.0
If: inL >= 1 && inL <= inputChannelCount
  Copy: VML=`inL`
EndIf:
If: inR >= 1 && inR <= inputChannelCount
  Copy: VMR=`inR`
EndIf:
If: inC >= 1 && inC <= inputChannelCount
  Copy: VMC=`inC`
EndIf:
If: inLs >= 1 && inLs <= inputChannelCount
  Copy: VMLS=`inLs`
EndIf:
If: inRs >= 1 && inRs <= inputChannelCount
  Copy: VMRS=`inRs`
EndIf:
If: inLb >= 1 && inLb <= inputChannelCount
  Copy: VMLB=`inLb`
EndIf:
If: inRb >= 1 && inRb <= inputChannelCount
  Copy: VMRB=`inRb`
EndIf:
If: inTfl >= 1 && inTfl <= inputChannelCount
  Copy: VMTFL=`inTfl`
EndIf:
If: inTfr >= 1 && inTfr <= inputChannelCount
  Copy: VMTFR=`inTfr`
EndIf:
If: inTbl >= 1 && inTbl <= inputChannelCount
  Copy: VMTBL=`inTbl`
EndIf:
If: inTbr >= 1 && inTbr <= inputChannelCount
  Copy: VMTBR=`inTbr`
EndIf:
If: inLFE >= 1 && inLFE <= inputChannelCount
  Copy: VLFE=`inLFE`
EndIf:

Include: secs_ultra200\secs_ultra200.txt

# Outputs: clear the input channels first (no raw signal leaks), then write each SECS output.
If: inL >= 1 && inL <= outputChannelCount
  Copy: `inL`=0.0
EndIf:
If: inR >= 1 && inR <= outputChannelCount
  Copy: `inR`=0.0
EndIf:
If: inC >= 1 && inC <= outputChannelCount
  Copy: `inC`=0.0
EndIf:
If: inLs >= 1 && inLs <= outputChannelCount
  Copy: `inLs`=0.0
EndIf:
If: inRs >= 1 && inRs <= outputChannelCount
  Copy: `inRs`=0.0
EndIf:
If: inLb >= 1 && inLb <= outputChannelCount
  Copy: `inLb`=0.0
EndIf:
If: inRb >= 1 && inRb <= outputChannelCount
  Copy: `inRb`=0.0
EndIf:
If: inTfl >= 1 && inTfl <= outputChannelCount
  Copy: `inTfl`=0.0
EndIf:
If: inTfr >= 1 && inTfr <= outputChannelCount
  Copy: `inTfr`=0.0
EndIf:
If: inTbl >= 1 && inTbl <= outputChannelCount
  Copy: `inTbl`=0.0
EndIf:
If: inTbr >= 1 && inTbr <= outputChannelCount
  Copy: `inTbr`=0.0
EndIf:
If: inLFE >= 1 && inLFE <= outputChannelCount
  Copy: `inLFE`=0.0
EndIf:
If: outL >= 1 && outL <= outputChannelCount
  Copy: `outL`=VML
EndIf:
If: outR >= 1 && outR <= outputChannelCount
  Copy: `outR`=VMR
EndIf:
If: outC >= 1 && outC <= outputChannelCount
  Copy: `outC`=VMC
EndIf:
If: outLs >= 1 && outLs <= outputChannelCount
  Copy: `outLs`=VMLS
EndIf:
If: outRs >= 1 && outRs <= outputChannelCount
  Copy: `outRs`=VMRS
EndIf:
If: outLb >= 1 && outLb <= outputChannelCount
  Copy: `outLb`=VMLB
EndIf:
If: outRb >= 1 && outRb <= outputChannelCount
  Copy: `outRb`=VMRB
EndIf:
If: outTfl >= 1 && outTfl <= outputChannelCount
  Copy: `outTfl`=VMTFL
EndIf:
If: outTfr >= 1 && outTfr <= outputChannelCount
  Copy: `outTfr`=VMTFR
EndIf:
If: outTbl >= 1 && outTbl <= outputChannelCount
  Copy: `outTbl`=VMTBL
EndIf:
If: outTbr >= 1 && outTbr <= outputChannelCount
  Copy: `outTbr`=VMTBR
EndIf:
If: outSW1 >= 1 && outSW1 <= outputChannelCount
  Copy: `outSW1`=VBSW1
EndIf:
If: outSW2 >= 1 && outSW2 <= outputChannelCount
  Copy: `outSW2`=VBSW2
EndIf:
If: outSW3 >= 1 && outSW3 <= outputChannelCount
  Copy: `outSW3`=VBSW3
EndIf:
Channel: all
